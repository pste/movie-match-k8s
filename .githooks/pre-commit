#!/usr/bin/env bash
# Protegge i dati che non devono entrare nel repo. Si attiva una volta per
# clone con: git config core.hooksPath .githooks

# 1. Il lock file: c'e' finche' decrypt.sh e' stato lanciato e encrypt.sh no.
if [ -f decrypted ]; then
  echo "I secrets sono DECIFRATI!"
  echo "Lancia ./encrypt.sh prima di committare."
  exit 1
fi

# 2. Il contenuto: il lock non copre il caso di un file creato a mano da un
#    .dist e mai passato per decrypt.sh.
#    --diff-filter con la R: senza, un file rinominato sfugge al controllo.
for FNAME in $(git diff --cached --name-only --diff-filter=ACMR | grep '^k8s/secrets/.*\.yaml$'); do
  case "$FNAME" in
    *kustomization.yaml) continue ;;
  esac
  if ! git show ":$FNAME" | grep -q 'ENC\[AES256_GCM'; then
    echo "$FNAME non e' cifrato con SOPS: commit annullata."
    echo "Lancia ./encrypt.sh."
    exit 1
  fi
done

# 3. I manifest di k8s/manual/ devono restare parametrici: si guardano le righe
#    host: e gli elementi della lista hosts:, che devono contenere ancora ${.
for FNAME in $(git diff --cached --name-only --diff-filter=ACMR | grep '^k8s/manual/.*\.yaml$'); do
  LEAKS=$(git show ":$FNAME" \
    | grep -v '^[[:space:]]*#' \
    | grep -E '^[[:space:]]*(-[[:space:]]*)?host:|^[[:space:]]*-[[:space:]]+[^:[:space:]]+\.[^:[:space:]]+[[:space:]]*$' \
    | grep -v '\${')
  if [ -n "$LEAKS" ]; then
    echo "$FNAME contiene un valore al posto del segnaposto: commit annullata."
    echo "I valori veri vanno in .env, non nel manifest."
    exit 1
  fi
done
